# Supabase — ambil dari Dashboard > Project Settings > API
# (URL project: https://xxxx.supabase.co, key: "anon / public" atau "publishable" key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Kunci "service_role" Supabase — HANYA dipakai di server (route /api/tx).
# Jangan pernah diberi awalan NEXT_PUBLIC_ dan jangan disebar: kunci ini
# melewati RLS, jadi siapa pun yang memegangnya bisa membaca/menulis semua order.
SUPABASE_SERVICE_ROLE_KEY=

# Password untuk masuk ke /admin (satu password bersama).
# Dicek di server (/api/admin/login) dan tidak pernah dikirim ke browser.
ADMIN_PASSWORD=

# Kunci tanda tangan cookie sesi admin — buat acak, jangan dibagikan.
# Contoh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Ganti nilainya = semua sesi admin yang beredar langsung tidak berlaku lagi.
ADMIN_SESSION_SECRET=
