# Supabase — ambil dari Dashboard > Project Settings > API
# (URL project: https://xxxx.supabase.co, key: "anon / public" atau "publishable" key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# PIN admin untuk ganti/hapus foto QRIS di /admin/pengaturan.
# Dicek di server (route /api/qris), tidak pernah dikirim ke browser.
ADMIN_PIN=
